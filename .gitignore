# ==============================================================================
# Git Ignore Rules for ESP32 Qt Windows App
# ==============================================================================

# Build Directories & Artifacts
build/
bin/
out/
dist/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
*.ninja_deps
*.ninja_log
*.dir/

# Compiled Binaries & Libraries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
*.exp
*.ilk
*.pdb

# Qt Generated Files
*.moc
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qmlc
*.jsc
ESP32QtApp_autogen/

# IDE & Editor Configurations
CMakeLists.txt.user*
.vs/
*.sln
*.vcxproj*
.vscode/
*.swp
*.swo
*~
.idea/

# Runtime Data, Logs & Local Stores
*.log
app.log
devices.json
*.local

# Python Caches (for tools/ simulator)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Arduino / PlatformIO Temporary Files
.pio/
*.hex
*.elf
*.bin

# Operating System Specific
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
